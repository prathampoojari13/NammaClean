# ==============================================================================
# NammaClean Environment Variables Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Application Configuration
APP_NAME=NammaClean
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Database Configuration
# NOTE: Host port 5433 is mapped to container port 5432 in docker-compose.yml
# to avoid conflicts with other existing PostgreSQL services.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nammaclean_db
POSTGRES_USER=nammaclean_admin
POSTGRES_PASSWORD=change_me_in_local_env

# Security & Authentication Configuration
# Generate a cryptographically strong random secret for JWT signing in local .env:
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Controlled GPS Simulation Engine & Map Data Controls
SIMULATION_ENABLED=false
VEHICLE_FRESHNESS_MINUTES=15

# Evidence Storage Configuration
EVIDENCE_STORAGE_PATH=data/uploads/evidence
MAX_EVIDENCE_FILE_SIZE_BYTES=5242880
