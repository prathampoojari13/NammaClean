# ==============================================================================
# NammaClean Environment Variables Template
# Copy this file to .env and adjust values for your local or production environment:
#   cp .env.example .env
# ==============================================================================

# Application Configuration
APP_NAME=NammaClean
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# CORS Origins (Comma-separated or JSON list of allowed frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL + PostGIS Database Configuration
# Cloud hosting option (Render / Supabase / Neon / Railway provide DATABASE_URL):
# DATABASE_URL=postgresql://user:password@host:5432/nammaclean_db
#
# Local Docker development options:
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nammaclean_db
POSTGRES_USER=nammaclean_admin
POSTGRES_PASSWORD=change_me_in_local_env

# Security & Authentication Configuration
# Generate a cryptographically strong random secret for JWT signing:
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Controlled GPS Simulation Engine & Map Data Controls
SIMULATION_ENABLED=false
VEHICLE_FRESHNESS_MINUTES=15

# Evidence Storage Configuration
EVIDENCE_STORAGE_PATH=data/uploads/evidence
MAX_EVIDENCE_FILE_SIZE_BYTES=5242880

# Pilot Operational Area & Bengaluru City-Wide Map Configuration
PILOT_ACTIVE=true
PILOT_ZONE_NAME=Yelahanka – Avalahalli (BMSIT&M)
PILOT_WARD_CODE=BBMP-W004
PILOT_WARD_NAME=Ward 4 - Yelahanka Satellite Town & Avalahalli Corridor
PILOT_CENTER_LAT=13.1331
PILOT_CENTER_LON=77.5685
PILOT_DEFAULT_GEOFENCE_METERS=150
BENGALURU_CENTER_LAT=12.9716
BENGALURU_CENTER_LON=77.5946
BENGALURU_DEFAULT_ZOOM=12
