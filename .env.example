# ==============================================================================
# NammaClean Environment Variables Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Application Configuration
APP_NAME=NammaClean
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Database Configuration
# NOTE: Host port 5433 is mapped to container port 5432 in docker-compose.yml
# to avoid conflicts with other existing PostgreSQL services.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nammaclean_db
POSTGRES_USER=nammaclean_admin
POSTGRES_PASSWORD=change_me_in_local_env
